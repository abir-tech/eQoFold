# Credentials -- Dirac-3 / QCi tokens must never be committed.
.env
*.token
qci_*.json

# Generated data. The reference table is the one exception: it is committed so
# that `make verify` can diff a fresh build against it, which is the Phase 1
# exit criterion.
data/references/*
!data/references/vienna_reference.csv
!data/references/.gitkeep

# Results are committed: figures illustrate the committed tables, and
# 'make verify' diffs regenerated output against them.
!results/tables/*.csv
!results/figures/*.png
